{
  "[glimmer-js]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.foldingStrategy": "indentation"
  },
  "[glimmer-ts]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.foldingStrategy": "indentation"
  },
  "[python]": {
    "editor.formatOnType": true
  },

  // Atlascode extension
  "atlascode.bitbucket.enabled": false,
  "atlascode.jira.jqlList": [
    {
      "enabled": true,
      "id": "51dede15-2d06-4c28-bcbd-35e15b520c9b",
      "monitor": true,
      "name": "Assigned to me",
      "query": "assignee = currentUser() AND resolution = Unresolved AND status != \"Won't do\" ORDER BY lastViewed DESC",
      "siteId": "4ccdf8b1-2061-45db-ac00-3914c5ffddb0"
    },
    {
      "enabled": true,
      "id": "2541d149-4914-4492-a17f-9a078b4cbcf1",
      "monitor": false,
      "name": "FE Platform issues",
      "query": "project = Frontend OR project = Prism",
      "siteId": "4ccdf8b1-2061-45db-ac00-3914c5ffddb0"
    }
  ],
  "atlascode.jira.lastCreateSiteAndProject": {
    "projectKey": "FE",
    "siteId": "4ccdf8b1-2061-45db-ac00-3914c5ffddb0"
  },

  "chat.agent.enabled": true,
  "chat.mcp.enabled": true,
  "chat.mcp.discovery.enabled": true,

  // Spell cheker extension
  "cSpell.userWords": [
    "actuals",
    "Arnaud",
    "combobox",
    "compset",
    "cond",
    "defintion",
    "Droppable",
    "financials",
    "Highcharts",
    "hypernova",
    "kanban",
    "labelledby",
    "listbox",
    "Memoization",
    "monospaced",
    "mylighthouse",
    "nullish",
    "Onboarding",
    "organisation",
    "prefetch",
    "prefilled",
    "refetch",
    "refetched",
    "REPRIORITIZED",
    "scrollable",
    "sideload",
    "sideloaded",
    "stylelint",
    "submarket",
    "teamleader",
    "Timesheets",
    "timetracking",
    "timetrackings",
    "Tooltipped",
    "unmount",
    "Upsell",
    "usersnap",
    "warpdrive",
    "Weyts"
  ],

  "cssVariables.lookupFiles": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "node_modules/@mylighthouse/prism-foundation/dist/styles/lib/tokens.css",
    "node_modules/@mylighthouse/prism-foundation/dist/styles/lib/typography.css"
  ],

  "diffEditor.experimental.showMoves": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.maxComputationTime": 0,
  "diffEditor.renderSideBySide": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "editor.fontFamily": "'Monaspace Neon', monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
  "editor.fontSize": 14,

  "editor.formatOnSave": true,
  "editor.guides.indentation": false,
  "editor.inlayHints.enabled": "on",
  "editor.inlineSuggest.enabled": true,
  "editor.lineHeight": 26,
  "editor.multiCursorModifier": "alt",
  "editor.stickyScroll.enabled": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,

  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "postcss": "css",
    "typescript": "typescriptreact"
  },

  // Eslint extension
  "eslint.validate": ["javascript", "typescript", "glimmer-ts", "glimmer-js"],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  "explorer.confirmDragAndDrop": false,

  // Extension VSCode Neovim
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  "files.associations": {
    "*.js": "javascript",
    "*.jsx": "javascriptreact",
    "*.snap": "javascriptreact",
    "*.tsx": "typescriptreact"
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true
  },

  // Git settings
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",

  // Github Copilot
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use conventional commit message format."
    }
  ],
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": true,
    "scminput": false,
    "yaml": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,

  // Gitlens
  "gitlens.advanced.blame.customArguments": [
    "--ignore-revs-file .git-blame-ignore-revs"
  ],
  "gitlens.advanced.messages": {
    "suppressCreatePullRequestPrompt": true
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:claude-3.7-sonnet",
  "gitlens.autolinks": [
    {
      "alphanumeric": false,
      "ignoreCase": false,
      "prefix": null,
      "url": null
    }
  ],
  "gitlens.graph.dimMergeCommits": true,
  "gitlens.remotes": [
    {
      "domain": "git.otainsight.com",
      "type": "GitLab"
    }
  ],
  "gitlens.views.branches.branches.layout": "list",
  "gitlens.views.commits.files.layout": "tree",
  "gitlens.views.scm.grouped.views": {
    "branches": false,
    "commits": false,
    "contributors": true,
    "launchpad": false,
    "remotes": true,
    "repositories": false,
    "searchAndCompare": false,
    "stashes": false,
    "tags": true,
    "worktrees": true
  },
  "gitlens.views.stashes.files.layout": "list",

  // Drawio extension
  "hediet.vscode-drawio.appearance": "light",
  "hediet.vscode-drawio.resizeImages": null,
  "hediet.vscode-drawio.theme": "kennedy",

  // I18n Ally extension
  "i18n-ally.enabledFrameworks": ["ember"],

  "javascript.preferences.importModuleSpecifier": "non-relative",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.validate.enable": false,

  // Peacock extension
  "peacock.favoriteColors": [
    {
      "name": "Angular Red",
      "value": "#dd0531"
    },
    {
      "name": "Azure Blue",
      "value": "#007fff"
    },
    {
      "name": "JavaScript Yellow",
      "value": "#f9e64f"
    },
    {
      "name": "Mandalorian Blue",
      "value": "#1857a4"
    },
    {
      "name": "Node Green",
      "value": "#215732"
    },
    {
      "name": "React Blue",
      "value": "#61dafb"
    },
    {
      "name": "Something Different",
      "value": "#832561"
    },
    {
      "name": "Svelte Orange",
      "value": "#ff3d00"
    },
    {
      "name": "Vue Green",
      "value": "#42b883"
    }
  ],
  "peacock.surpriseMeOnStartup": true,

  "prettier.documentSelectors": ["**/*.gts", "**/*.gjs"],

  "python.terminal.activateEnvironment": false,

  "scm.defaultViewMode": "tree",
  "scss.validate": false,
  "security.workspace.trust.untrustedFiles": "open",

  // Stylelint extension
  "stylelint.snippet": ["css", "scss"],
  "stylelint.validate": ["css", "scss"],

  "task.problemMatchers.neverPrompt": {
    "npm": true
  },

  // Terminal settings
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.fontFamily": "'Monaspace Neon', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",

  // Typescript settings
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // Window settings
  "window.newWindowDimensions": "maximized",
  "window.restoreFullscreen": true,

  // Workbench settings
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Solarized Light+",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 7,
  "workbench.editor.wrapTabs": true,
  "workbench.layoutControl.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "readme",

  // Yaml settings
  "yaml.customTags": ["!reference sequence"],
  "yaml.schemas": {
    "file:///Users/arnaudweyts/.vscode/extensions/atlassian.atlascode-3.8.10/resources/schemas/pipelines-schema.json": "bitbucket-pipelines.yml"
  },
  "docker.extension.enableComposeLanguageServer": false,
  "gitlens.views.commitDetails.files.layout": "list"
}
